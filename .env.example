# IFRS web app – example environment. The static demo needs NONE of these.
# Copy to .env.local and fill in only when connecting real services. Never commit real values.

# Base path for GitHub Pages (repo name). Defaults to /ifrs/
VITE_BASE=/ifrs/

# Future backend (e.g. Supabase) – public anon key only; row-level security must enforce roles
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Optional default live sensor feed polled by the Tatil prototype page (HTTPS JSON)
# VITE_LIVE_FEED_URL=

# Server-side only (never expose to the browser):
# DEVICE_SHARED_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SENDGRID_API_KEY=
